# =============================================================================
# Healthcare AI System - Environment Configuration
# =============================================================================

# LLM Configuration (Groq - Free Tier)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_API_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_NUMBER=923000000000
WHATSAPP_VERIFY_TOKEN=my_secure_token

# System Configuration
TIER_LEVEL=gold
DEBUG_MODE=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_REASONING_LOGS=true

# Interview Configuration
MAX_INTERVIEW_QUESTIONS=15
MIN_INTERVIEW_QUESTIONS=5
INTERVIEW_TIMEOUT_MINUTES=20
RED_FLAG_CONFIDENCE_THRESHOLD=0.7

# Vector Store (Local ChromaDB)
CHROMA_PERSIST_DIR=src/data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# Security
SECRET_KEY=generate_a_random_string_here
ALLOWED_HOSTS=*